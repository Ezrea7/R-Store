^https?:\/\/(?>api-cslp-emt|api\.globalstore)\.amazon\.cn\/gateway\/recommend url reject-dict
^https?:\/\/(?>api-cslp-emt|api\.globalstore)\.amazon\.cn\/gateway\/config\/getUpdatePopupConfig url reject-dict
^https?:\/\/(?>api-cslp-emt|api\.globalstore)\.amazon\.cn\/gateway\/content\/widget\/(?>popup|floatingWindow) url reject-dict

hostname = api-cslp-emt.amazon.cn, api.globalstore.amazon.cn
